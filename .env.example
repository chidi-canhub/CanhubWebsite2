# Contact form and email delivery
RESEND_API_KEY="replace-with-your-resend-api-key"
CONTACT_EMAIL_TO="contact@canhubsoftware.com"
CONTACT_EMAIL_FROM="noreply@canhub.example"

# Optional: shared server-side rate limiting for Vercel/serverless deployments
# Provide values from your Upstash Redis project if you want production rate limiting.
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"
CONTACT_RATE_LIMIT_MAX="5"
